{
  "sections": [
    {
      "id": "site-metadata",
      "title": "Site Metadata & Operations",
      "items": [
        { "id": "org-name", "label": "Organisation Name", "type": "text", "required": true },
        { "id": "site-name", "label": "Site Name", "type": "text", "required": true },
        { "id": "visit-date", "label": "Visit Date", "type": "date", "required": true },
        { "id": "inspector", "label": "Lead Inspector", "type": "text", "required": true },
        { "id": "facility-type", "label": "Facility Type", "type": "select", "options": ["School", "Hotel", "Leisure Centre", "Spa", "Hydrotherapy", "Other"], "required": true },
        { "id": "occupancy-max", "label": "Maximum Occupancy", "type": "number", "unit": "people" },
        { "id": "operating-hours", "label": "Operating Hours", "type": "text" }
      ]
    },
    {
      "id": "mgmt-docs",
      "title": "Management Documentation & Staffing",
      "items": [
        { "id": "nop-present", "label": "Normal Operating Procedures (NOP) present and current", "type": "status", "guidance": "HSE/PWTAG" },
        { "id": "eap-present", "label": "Emergency Action Plan (EAP) present and current", "type": "status", "guidance": "HSE/PWTAG" },
        { "id": "psop-present", "label": "Pool Safety Operating Procedures (PSOP) present and current", "type": "status", "guidance": "HSE/PWTAG" },
        { "id": "staff-training", "label": "Staff training records up to date", "type": "status" },
        { "id": "emergency-drills", "label": "Emergency drills conducted and recorded", "type": "status" },
        { "id": "safeguarding", "label": "Safeguarding policies implemented", "type": "status" }
      ]
    },
    {
      "id": "facility-access",
      "title": "Access, Safety & Welfare",
      "items": [
        { "id": "signage-depth", "label": "Depth markings clear and accurate", "type": "status" },
        { "id": "supervision-zones", "label": "Supervision zones clearly defined", "type": "status" },
        { "id": "slip-trip-hazards", "label": "Flooring free of slip/trip hazards", "type": "status" },
        { "id": "changing-welfare", "label": "Changing rooms and welfare facilities condition", "type": "status" },
        { "id": "accessibility", "label": "Disabled access and hoist functionality", "type": "status" },
        { "id": "rescue-equipment", "label": "Rescue equipment available and accessible", "type": "status" },
        { "id": "emergency-comms", "label": "Emergency communications (Phones/Radios) functional", "type": "status" }
      ]
    },
    {
      "id": "fire-safety",
      "title": "Fire & Emergency Precautions",
      "items": [
        { "id": "fire-exits", "label": "Emergency exits unobstructed and operational (e.g. push bars)", "type": "status" },
        { "id": "fire-alarms", "label": "Fire alarms tested and operational", "type": "status" },
        { "id": "evacuation-plan", "label": "Evacuation plan displayed and known to staff", "type": "status" }
      ]
    },
    {
