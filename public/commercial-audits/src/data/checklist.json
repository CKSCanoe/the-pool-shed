      "title": "Water Chemistry & Testing",
      "items": [
        { "id": "testing-logs", "label": "Water testing logs maintained and current", "type": "status" },
        { "id": "ph-level", "label": "pH Level", "type": "numeric", "unit": "pH", "min": 7.2, "max": 7.6 },
        { "id": "free-chlorine", "label": "Free Chlorine", "type": "numeric", "unit": "ppm", "min": 1.0, "max": 2.0 },
        { "id": "combined-chlorine", "label": "Combined Chlorine", "type": "numeric", "unit": "ppm", "max": 0.5 },
        { "id": "temp-water", "label": "Water Temperature", "type": "numeric", "unit": "°C" },
        { "id": "testing-method", "label": "Testing method (e.g. Photometer)", "type": "select", "options": ["Manual/DPD", "Photometer", "Automated"] }
      ]
    },
    {
      "id": "chem-handling",
      "title": "Chemical Handling & Dosing",
      "items": [
        { "id": "dosing-automation", "label": "Dosing automation functional", "type": "status" },
