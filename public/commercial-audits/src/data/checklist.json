      "title": "Plant Room & Mechanical",
      "items": [
        { "id": "circulation-flow", "label": "Circulation flow and turnover rates adequate", "type": "status" },
        { "id": "filtration-backwash", "label": "Filtration and backwash procedures correct", "type": "status" },
