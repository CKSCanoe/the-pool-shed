        { "id": "segregation", "label": "Acid and Chlorine stored separately", "type": "status", "guidance": "HSE" },
        { "id": "storage-sealed", "label": "Chemicals stored in sealed/overflow tanks", "type": "status" },
        { "id": "respirators", "label": "Suitable respirators available for plant room", "type": "status" }
