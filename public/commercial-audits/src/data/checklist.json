        { "id": "ahu-fans", "label": "AHU fans operational and noise levels acceptable", "type": "status" },
        { "id": "ahu-filters", "label": "AHU filters clean and recently changed", "type": "status" },
        { "id": "pressure-gauges", "label": "Filter pressure gauges functional and accurate", "type": "status" },
        { "id": "heating-system", "label": "Heating system functional and efficient", "type": "status" }
      ]
    },
    {
      "id": "structural-elec",
      "title": "Structural & Electrical",
      "items": [
        { "id": "shell-liner", "label": "Structural shell/liner/tiles condition", "type": "status" },
        { "id": "elec-safety", "label": "Plant electrical safety / RCDs operational", "type": "status" },
        { "id": "pool-lighting", "label": "Poolside and underwater lighting functional", "type": "status" }
      ]
    },
    {
      "id": "maintenance-records",
      "title": "Records & Maintenance",
      "items": [
        { "id": "ppm-records", "label": "Planned Preventative Maintenance (PPM) records current", "type": "status" },
        { "id": "calibration", "label": "Equipment calibration/verification records", "type": "status" }
      ]
    }
  ]
}
