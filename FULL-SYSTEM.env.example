# Public application build
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SECURE_WORKSPACE_WRITES=false

# Server-side workspace/accounting
# Preferred modern server key. Never expose this in browser code.
SUPABASE_SECRET_KEY=
# Legacy fallback during migration only.
SUPABASE_SERVICE_ROLE_KEY=
# Pool Shed browser/app URL. Do NOT put the Azzy gateway URL here.
APP_ORIGIN=https://your-pool-shed-domain.example
# Optional extra Pool Shed aliases/previews, comma-separated
APP_ORIGINS=
FINANCE_WORKSPACE_ID=pool-bros-main

# Xero is prepared but intentionally parked
XERO_INTEGRATION_MODE=ready
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_TOKEN_KEY=
XERO_WEBHOOK_KEY=
CRON_SECRET=

# Optional project review provider configuration belongs on the server only.

# Azzy shared local AI brain (server-side only)
# Point this at the secure Azzy Brain Gateway, never directly expose Ollama port 11434.
AZZY_OLLAMA_URL=https://your-azzy-brain-hostname.example
AZZY_OLLAMA_TOKEN=
AZZY_OLLAMA_MODEL=qwen3:8b

# Durable per-login conversation / decisions / watches
# Requires database/012-azzy-memory.sql
AZZY_MEMORY_MODE=external
