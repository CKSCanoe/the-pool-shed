# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-key

# Environment
NODE_ENV=production

# Feature Flags
ENABLE_OFFLINE_MODE=true
ENABLE_CATALOG_INTELLIGENCE=true
ENABLE_BUNDLE_ENGINE=true
ENABLE_PARTIAL_FULFILLMENT=true

# Performance
MAX_CACHE_AGE=31536000
STALE_WHILE_REVALIDATE=604800
