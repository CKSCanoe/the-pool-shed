# Copy to .env.phase0.local (git-ignored) and fill in. Never commit real values.
# Supabase dashboard → Project Settings → API: Project URL and the service_role secret.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Only needed for the restore drill (a second, empty Supabase project).
STAGING_SUPABASE_URL=https://YOUR-STAGING-REF.supabase.co
STAGING_SUPABASE_SERVICE_ROLE_KEY=
